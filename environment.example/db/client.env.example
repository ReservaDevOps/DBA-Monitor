PGHOST=10.0.0.10
PGPORT=5432
PGDATABASE=app_database
PGUSER=readonly_user
PGPASSWORD=change-me
PGSSLMODE=disable
AGENT_API_TOKEN=change-this-token
REQUIRE_API_TOKEN=true
REPORT_NAME=client-a
STATUS_INTERVAL_SECONDS=300
DAILY_REPORT_HOUR=2
DAILY_REPORT_MINUTE=0
STATEMENT_TIMEOUT_MS=30000
MAX_DATABASES_PER_REPORT=0

# Evolution API notifications.
# Keep real values only in environment/db/<client>.env.
EVOLUTION_ENABLED=false
EVOLUTION_API_URL=http://dba-evolution-api:8080
EVOLUTION_API_KEY=change-this-evolution-api-key
EVOLUTION_INSTANCE=Reserva Whats
EVOLUTION_TARGET_GROUP_JID=120000000000000000@g.us
EVOLUTION_SEND_PDF=true
EVOLUTION_TIMEOUT_SECONDS=20

# Optional warnings sent from the lightweight status collector.
# Empty threshold values disable that specific check.
STATUS_WARNINGS_ENABLED=false
STATUS_WARNING_COOLDOWN_SECONDS=3600
STATUS_WARNING_MAX_CONNECTIONS=
STATUS_WARNING_MAX_CONNECTIONS_PERCENT=80
STATUS_WARNING_MAX_LONG_QUERIES=0
STATUS_WARNING_MAX_WAITING_LOCKS=10
STATUS_WARNING_MAX_DATABASE_SIZE_GB=

# Optional OS metrics read from schema dba_monitor, populated by the local
# Linux collector. Empty threshold values disable that specific check.
OS_METRICS_ENABLED=false
OS_WARNING_MAX_FILESYSTEM_USED_PERCENT=90
OS_WARNING_MAX_MEMORY_USED_PERCENT=90
OS_WARNING_MAX_IOWAIT_PERCENT=20
OS_WARNING_MAX_COLLECTOR_LAG_SECONDS=180
