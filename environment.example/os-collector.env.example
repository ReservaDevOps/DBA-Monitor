# Example environment for the Linux host service.
# Keep real values only in environment/os-collector/<host>.env or another
# private location outside Git.

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=postgres
PGUSER=dba_monitor_collector
PGPASSWORD=change-me
PGSSLMODE=disable

# Optional libpq DSN. When set, it takes precedence over PG* variables.
OS_COLLECTOR_DSN=

# Prefer a stable, human-readable value per monitored server.
OS_COLLECTOR_HOST_ID=db-server-01
OS_COLLECTOR_POSTGRES_DATA_DIRECTORY=/var/lib/postgresql/16/main

OS_COLLECTOR_INTERVAL_SECONDS=60
OS_COLLECTOR_RETENTION_DAYS=30
OS_COLLECTOR_CPU_SAMPLE_SECONDS=1
OS_COLLECTOR_LOG_LEVEL=INFO
